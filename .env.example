# Postgres connection string. For local dev, point this at any Postgres
# instance (e.g. `postgresql://user:pass@localhost:5432/aiethicsupkeep`).
# For Vercel, use a hosted Postgres's *pooled* connection string (Neon,
# Vercel Postgres, or Supabase all provide one) since serverless functions
# open many short-lived connections.
DATABASE_URL="postgresql://user:password@localhost:5432/aiethicsupkeep"

# Required for live briefing generation, Ask My Archive, and Idea Constellations.
# Without this, the app still runs against seed/demo data.
ANTHROPIC_API_KEY=

# Required for scripts/send-morning-email.ts to actually deliver the brief.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Fallback recipient if Settings.recipientEmail isn't set via the UI.
BRIEFING_RECIPIENT=

# Used to build links back into the app from the emailed brief.
APP_URL=http://localhost:3000
